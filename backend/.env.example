# Copy this file to .env (or export these as real environment variables /
# IDE run-configuration variables) before starting the backend.
# NEVER commit the real .env file.

# ---- AI ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# AI_MODE=OPENAI
AI_MODE=MOCK
CONFIDENCE_THRESHOLD=0.85

# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/mailops
DB_USERNAME=root
DB_PASSWORD=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Seeding ----
SEED_ENABLED=true

# ---- Server ----
SERVER_PORT=8080
